DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-longa
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=sistema_estudos
MYSQL_USER=root
MYSQL_PASSWORD=root

JWT_SECRET_KEY=pode-ser-igual-ao-django-em-dev-ou-outra-chave
JWT_EXPIRATION_HOURS=24

# OAuth 2.0 Client ID (tipo Web) — mesmo valor do frontend VITE_GOOGLE_CLIENT_ID
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com

CORS_ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# URL do frontend (link no e-mail de recuperação de senha)
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_HOURS=1

# E-mail (SMTP) — deixe EMAIL_HOST vazio em dev: o link sai no console do runserver
# Gmail: use senha de app em https://myaccount.google.com/apppasswords
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=seu@gmail.com
# EMAIL_HOST_PASSWORD=senha-de-app-16-caracteres
# DEFAULT_FROM_EMAIL=StudyHub <seu@gmail.com>

# Assistente IA — Gemini (somente backend; nunca commitar a chave real)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Telegram — bot de notificações (somente backend)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
